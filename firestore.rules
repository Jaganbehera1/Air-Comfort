rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function getRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && getRole() == 'admin';
    }

    function isEngineer() {
      return signedIn() && getRole() == 'engineer';
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /contact_info/{doc} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /gallery_items/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /projects/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /site_visits/{doc} {
      allow create: if isEngineer() && request.resource.data.engineer_id == request.auth.uid;

      allow read: if isAdmin() ||
        (isEngineer() && resource.data.engineer_id == request.auth.uid);

      allow update: if isAdmin() ||
        (isEngineer() &&
         resource.data.engineer_id == request.auth.uid &&
         request.resource.data.engineer_id == request.auth.uid);

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
